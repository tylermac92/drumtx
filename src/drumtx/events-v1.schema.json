{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DrumTx events.json, schema version 1",
  "description": "Documented in docs/schema/events-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "settings",
    "models",
    "csv_sha256",
    "tempo_map",
    "events",
    "measure_flags"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "duration_s", "start_s", "end_s"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "start_s": { "type": ["number", "null"], "minimum": 0 },
        "end_s": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "settings": { "type": "object" },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detector", "beat_tracker", "separator"],
      "properties": {
        "detector": { "type": "string", "minLength": 1 },
        "beat_tracker": { "type": ["string", "null"], "minLength": 1 },
        "separator": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "csv_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "tempo_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beats",
        "time_signatures",
        "tempo_source",
        "time_signature_source",
        "first_downbeat_source"
      ],
      "properties": {
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["time_s", "measure", "beat"],
            "properties": {
              "time_s": { "type": "number" },
              "measure": { "type": "integer", "minimum": 0 },
              "beat": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "time_signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["measure", "beats", "beat_type"],
            "properties": {
              "measure": { "type": "integer", "minimum": 1 },
              "beats": { "type": "integer", "minimum": 1 },
              "beat_type": { "const": 4 }
            }
          }
        },
        "tempo_source": { "enum": ["estimated", "user"] },
        "time_signature_source": { "enum": ["default", "user"] },
        "first_downbeat_source": { "enum": ["estimated", "user"] }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time_s", "class", "confidence", "velocity", "quantized", "flags"],
        "properties": {
          "time_s": { "type": "number", "minimum": 0 },
          "class": { "enum": ["kick", "snare", "hihat", "tom", "cymbal"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "velocity": { "type": "integer", "minimum": 1, "maximum": 127 },
          "quantized": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["measure", "beat", "grid", "slot", "residual_ms", "residual_frac"],
                "properties": {
                  "measure": { "type": "integer", "minimum": 0 },
                  "beat": { "type": "integer", "minimum": 1 },
                  "grid": { "enum": ["16th", "triplet"] },
                  "slot": { "type": "integer", "minimum": 1, "maximum": 4 },
                  "residual_ms": { "type": "number" },
                  "residual_frac": { "type": "number", "minimum": -0.5, "maximum": 0.5 }
                }
              }
            ]
          },
          "flags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["uncertain", "merged"] }
          }
        }
      }
    },
    "measure_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["measure", "flags"],
        "properties": {
          "measure": { "type": "integer", "minimum": 0 },
          "flags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["uncertain", "off_grid", "tempo", "merged"] }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
